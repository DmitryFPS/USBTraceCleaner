<UserControl x:Class="USBTraceCleaner.Views.OtherUsbTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="TxtOtherPhase" Text="" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" Margin="0,0,0,4"/>
            <ProgressBar x:Name="ProgressOther" Height="4" Minimum="0" Maximum="100"
                         Background="#E2E8F0" Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="0"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Другие USB-следы" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Дополнительные записи о моделях USB. Здесь могут быть записи о подключённых устройствах."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource MainCard}" Margin="0,0,0,12">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ChkOtherSimulation" Content="Проверка без удаления" IsChecked="True" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                        Text="Дополнительный раздел для опытных пользователей. Выбирайте только знакомые записи. Общие журналы не изменяются; резервная копия на этой вкладке не создаётся."/>
                </StackPanel>
            </Border>

            <Border x:Name="OtherResultsHost" Grid.Row="2" Style="{StaticResource MainCard}" MinHeight="180">
                <Grid x:Name="OtherResultsGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="0"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushModern}"
                            BorderThickness="0,0,0,1" Padding="14,10">
                        <TextBlock x:Name="TxtOtherCount" Text="Найдено: 0" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                    <DataGrid x:Name="GridOtherTraces" Grid.Row="1"
                              Style="{StaticResource ResultsDataGrid}"
                              CellStyle="{StaticResource ResultsDataGridCell}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="44" MinWidth="44" CanUserResize="False"
                                                    CellStyle="{StaticResource ResultsDataGridCheckCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBox}"
                                                  IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                                  Click="TraceCheck_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" IsReadOnly="True" Width="230"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding DisplayConnection}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="VID" Binding="{Binding DisplayVid}" IsReadOnly="True" Width="64" MinWidth="56">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding DisplayPid}" IsReadOnly="True" Width="64" MinWidth="56">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" IsReadOnly="True" Width="200" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" IsReadOnly="True" Width="220" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Первое подкл." Binding="{Binding DisplayFirstConnected}" IsReadOnly="True" Width="150" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Источник" Binding="{Binding SourceLabel}" IsReadOnly="True" Width="160" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Путь в реестре" Binding="{Binding DisplayLocation}" IsReadOnly="True" Width="200" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
