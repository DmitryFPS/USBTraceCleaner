<Window x:Class="USBTraceCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:USBTraceCleaner.Views"
        Title="USB Trace Cleaner"
        Height="800" Width="1180"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/USBTraceCleaner;component/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,20">
                    <Border Background="#1D4ED8" CornerRadius="6" Padding="8,3"
                            HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="USB / TYPE-C" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="USB Trace Cleaner" Foreground="White"
                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Text="Найдите старые подключения и выберите, что убрать"
                               Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtAdminWarning" Foreground="#FCA5A5"
                               FontWeight="SemiBold" FontSize="11" Margin="0,10,0,0"
                               Visibility="Collapsed" Text="Запустите от имени администратора"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#111C2F" BorderBrush="#243247"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtOsBadge" Text="Windows 10/11"
                                   Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtAppVersion" Text="версия 1.4.1" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="КАТЕГОРИИ"
                               Foreground="#64748B" FontWeight="SemiBold" FontSize="10"
                               Margin="4,0,0,8"/>
                    <ListBox x:Name="LstCategories" Style="{StaticResource CategoryListBox}"
                             ItemContainerStyle="{StaticResource CategoryListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0"
                                               FontSize="10" Opacity="0.8"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               Text="{Binding Count, StringFormat={}{0}}"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabs" Grid.Row="0"
                        Style="{StaticResource AppTabControl}"
                        SelectionChanged="MainTabs_SelectionChanged">
                <!-- USB -->
                <TabItem Header="USB" Style="{StaticResource AppTabItem}">
                    <DockPanel Margin="20,0,20,12" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock x:Name="TxtPhase" Text="" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100"
                                         Background="#E2E8F0" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="0"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Ваши USB-устройства" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="1. Найдите устройства   →   2. Выберите ненужные записи   →   3. Проверьте без удаления"
                                           Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource MainCard}" Margin="0,0,0,12">
                                <StackPanel Margin="12">
                                    <WrapPanel>
                                        <CheckBox x:Name="ChkSimulation" Style="{StaticResource CompactCheckBox}"
                                            Content="Проверка без удаления" IsChecked="True" Margin="0,0,20,6"
                                            Checked="UsbModeChanged" Unchecked="UsbModeChanged"
                                            ToolTip="Показывает план действий. Чтобы удалить записи, снимите эту галочку."/>
                                        <CheckBox x:Name="ChkBackup" Style="{StaticResource CompactCheckBox}"
                                            Content="Сохранить резервную копию реестра" IsChecked="True"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtUsbHint" TextWrapping="Wrap" Foreground="#475569" Margin="0,2,0,8"/>
                                    <Expander Header="Дополнительные настройки — для опытных пользователей">
                                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,10,0,0">
                                                <CheckBox x:Name="ChkAdvancedScan" Style="{StaticResource CompactCheckBox}"
                                                    Content="Расширенный поиск: общие журналы, история и дополнительные ветви реестра" IsChecked="False"/>
                                                <TextBlock Text="Изменили настройки поиска? Выполните сканирование заново. Общие записи могут относиться сразу к нескольким устройствам."
                                                    TextWrapping="Wrap" Foreground="#92400E" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
<CheckBox x:Name="ChkCloseExplorer" Style="{StaticResource CompactCheckBox}" Content="Закрывать Проводник при удалении" IsChecked="False"/>
<CheckBox x:Name="ChkReboot" Style="{StaticResource CompactCheckBox}" Content="Перезагрузить ПК после успешного удаления" IsChecked="False"/>
<CheckBox x:Name="ChkMtp" Style="{StaticResource CompactCheckBox}" Content="Искать телефоны и камеры (MTP)" IsChecked="True"/>
<CheckBox x:Name="ChkRestorePoint" Style="{StaticResource CompactCheckBox}" Content="Создать точку восстановления Windows" IsChecked="False"/>
<CheckBox x:Name="ChkScrubLogs" Style="{StaticResource CompactCheckBox}" Content="Обрабатывать содержимое выбранных логов" IsChecked="True"/>
<CheckBox x:Name="ChkPreserveLogDates" Style="{StaticResource CompactCheckBox}" Content="Сохранять даты выбранных логов" IsChecked="True"/>
<CheckBox x:Name="ChkShellBags" Style="{StaticResource CompactCheckBox}" Content="История вида папок (ShellBags)" IsChecked="False"/>
<CheckBox x:Name="ChkRecentLinks" Style="{StaticResource CompactCheckBox}" Content="Недавние файлы и ярлыки" IsChecked="False"/>
<CheckBox x:Name="ChkBam" Style="{StaticResource CompactCheckBox}" Content="История запуска программ (BAM/DAM)" IsChecked="False"/>
<CheckBox x:Name="ChkExecution" Style="{StaticResource CompactCheckBox}" Content="Кэш запуска программ (Prefetch / Amcache)" IsChecked="False"/>
<CheckBox x:Name="ChkExplorerMru" Style="{StaticResource CompactCheckBox}" Content="История Проводника и окон выбора файлов" IsChecked="False"/>
<CheckBox x:Name="ChkRecycle" Style="{StaticResource CompactCheckBox}" Content="Записи USB-файлов в корзине" IsChecked="False"/>
<CheckBox x:Name="ChkSelfTraces" Style="{StaticResource CompactCheckBox}" Content="История запуска утилит очистки" IsChecked="False"/>
<CheckBox x:Name="ChkSystemLog" Style="{StaticResource CompactCheckBox}" Content="Включать системный журнал Windows" IsChecked="False"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border x:Name="UsbResultsHost" Grid.Row="2" Style="{StaticResource MainCard}" MinHeight="180">
                                <Grid x:Name="UsbResultsGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="0"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Background="#F8FAFC" Margin="10">
                                        <TextBlock x:Name="TxtFoundCount" Text="Найдено: 0" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <CheckBox x:Name="ChkDisconnectedOnly" DockPanel.Dock="Right" Content="Только отключённые"
                                                Margin="12,0,0,0" VerticalAlignment="Center" Checked="UsbFilterChanged" Unchecked="UsbFilterChanged"/>
                                            <TextBox x:Name="TxtDeviceSearch" Padding="7,5" TextChanged="UsbFilterChanged"
                                                ToolTip="Поиск по имени устройства, пути, VID/PID или серийному номеру"/>
                                        </DockPanel>
                                        <TextBlock Text="Поиск по имени, пути или серийному номеру" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <DataGrid x:Name="GridArtifacts" Grid.Row="1"
                                              Style="{StaticResource ResultsDataGrid}"
                                              CellStyle="{StaticResource ResultsDataGridCell}"
                                              AutoGenerateColumns="False" IsReadOnly="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="✓" Width="40" CanUserResize="False" CellStyle="{StaticResource ResultsDataGridCheckCell}">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <CheckBox Style="{StaticResource GridCheckBox}" IsEnabled="{Binding CanSelect}"
                                                        IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Click="ArtifactCheck_Click"
                                                        ToolTip="Подключённые устройства защищены от выбора"/>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" IsReadOnly="True" Width="300" MinWidth="220">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"><Setter Property="ToolTip" Value="{Binding DeviceName}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Состояние" Binding="{Binding DisplayConnection}" IsReadOnly="True" Width="155" MinWidth="105">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"><Setter Property="ToolTip" Value="{Binding DisplayConnection}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Что найдено" Binding="{Binding DisplayType}" IsReadOnly="True" Width="130" MinWidth="105">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"><Setter Property="ToolTip" Value="{Binding DisplayType}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Где хранится" Binding="{Binding DisplaySource}" IsReadOnly="True" Width="135" MinWidth="105">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"><Setter Property="ToolTip" Value="{Binding DisplaySource}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Row="2" Background="#EFF6FF" Padding="12" DataContext="{Binding SelectedItem, ElementName=GridArtifacts}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceName, FallbackValue=Выберите строку для подробностей}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DeviceNameSource}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CleanupEffect}" Margin="0,5,0,5" TextWrapping="Wrap" Foreground="#92400E"/>
                                            <TextBox Text="{Binding DisplayLocation, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                TextWrapping="Wrap" MaxHeight="55" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- Network -->
                <TabItem Header="Аудит сети" Style="{StaticResource AppTabItem}">
                    <views:NetworkAuditView x:Name="NetworkView" Margin="20,0,20,12"
                                            CategoriesChanged="NetworkView_CategoriesChanged"/>
                </TabItem>
                <!-- Other USB traces -->
                <TabItem Header="Другие USB-следы" Style="{StaticResource AppTabItem}">
                    <views:OtherUsbTraceView x:Name="OtherUsbView" Margin="20,0,20,12"/>
                </TabItem>
                <!-- Event Viewer -->
                <TabItem Header="Журналы событий" Style="{StaticResource AppTabItem}">
                    <views:EventLogsView x:Name="EventLogsView" Margin="20,0,20,12"/>
                </TabItem>
            </TabControl>

            <!-- USB actions -->
            <Border x:Name="UsbBottomBar" Grid.Row="1" Style="{StaticResource ActionFooter}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" x:Name="BtnUsbLog" Content="Журнал"
                            Style="{StaticResource SecondaryButton}" MinWidth="96"
                            Click="BtnUsbLog_Click"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnUsbReport" Content="Отчёт PDF"
                            Style="{StaticResource SecondaryButton}" MinWidth="108" Margin="8,0,0,0"
                            Click="BtnUsbReport_Click"/>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="BtnSelectAll" Content="Выбрать видимые" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="BtnSelectAll_Click"/>
                        <Button x:Name="BtnDeselectAll" Content="Снять все" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="BtnDeselectAll_Click"/>
                        <Button x:Name="BtnScan" Content="Найти устройства" Style="{StaticResource PrimaryButton}"
                                MinWidth="124" Margin="0,0,8,0" Click="BtnScan_Click"/>
                        <Button x:Name="BtnFixDuplicates" Content="Найти старые записи" Style="{StaticResource SecondaryButton}"
                                MinWidth="140" Margin="0,0,8,0" Click="BtnFixDuplicates_Click"/>
                        <Button x:Name="BtnClean" Content="Очистить" Style="{StaticResource DangerButton}"
                                MinWidth="124" Click="BtnClean_Click"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Network actions -->
            <Border x:Name="NetworkBottomBar" Grid.Row="1" Style="{StaticResource ActionFooter}" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" x:Name="BtnNetworkLog" Content="Журнал"
                            Style="{StaticResource SecondaryButton}" MinWidth="96"
                            Click="BtnNetworkLog_Click"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnNetworkReport" Content="Отчёт PDF"
                            Style="{StaticResource SecondaryButton}" MinWidth="108" Margin="8,0,0,0"
                            Click="BtnNetworkReport_Click"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnNetworkSummary" Content="Сводка подключений"
                            Style="{StaticResource SecondaryButton}" MinWidth="168" Margin="8,0,0,0"
                            Click="BtnNetworkSummary_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnNetworkHelp" Content="Что удалится?" Style="{StaticResource SecondaryButton}"
                                MinWidth="120" Margin="0,0,8,0" Click="NetworkHelp_Click"/>
                        <Button x:Name="BtnNetworkSelect" Content="Выбрать все" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="NetworkSelectAll_Click"/>
                        <Button x:Name="BtnNetworkDeselect" Content="Снять все" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="NetworkDeselect_Click"/>
                        <Button x:Name="BtnNetworkScan" Content="Сканировать" Style="{StaticResource PrimaryButton}"
                                MinWidth="124" Margin="0,0,8,0" Click="NetworkScan_Click"/>
                        <Button x:Name="BtnNetworkClean" Content="Очистить следы" Style="{StaticResource DangerButton}"
                                MinWidth="140" Click="NetworkClean_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Other USB traces actions -->
            <Border x:Name="OtherUsbBottomBar" Grid.Row="1" Style="{StaticResource ActionFooter}" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" x:Name="BtnOtherUsbLog" Content="Журнал"
                            Style="{StaticResource SecondaryButton}" MinWidth="96"
                            Click="BtnOtherUsbLog_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnOtherUsbSelect" Content="Выбрать все" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="OtherUsbSelectAll_Click"/>
                        <Button x:Name="BtnOtherUsbDeselect" Content="Снять все" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="OtherUsbDeselect_Click"/>
                        <Button x:Name="BtnOtherUsbScan" Content="Сканировать" Style="{StaticResource PrimaryButton}"
                                MinWidth="124" Margin="0,0,8,0" Click="OtherUsbScan_Click"/>
                        <Button x:Name="BtnOtherUsbClean" Content="Очистить выбранное" Style="{StaticResource DangerButton}"
                                MinWidth="168" Click="OtherUsbClean_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Event logs actions -->
            <Border x:Name="EventLogsBottomBar" Grid.Row="1" Style="{StaticResource ActionFooter}" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" x:Name="BtnEventLogsLog" Content="Журнал"
                            Style="{StaticResource SecondaryButton}" MinWidth="96"
                            Click="BtnEventLogsLog_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnEventLogsSelect" Content="Выбрать все" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="EventLogsSelectAll_Click"/>
                        <Button x:Name="BtnEventLogsDeselect" Content="Снять все" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="EventLogsDeselect_Click"/>
                        <Button x:Name="BtnEventLogsEvents" Content="События" Style="{StaticResource SecondaryButton}"
                                MinWidth="108" Margin="0,0,8,0" Click="EventLogsEvents_Click"
                                ToolTip="Просмотр записей выбранного канала (или двойной клик по строке)"/>
                        <Button x:Name="BtnEventLogsRefresh" Content="Обновить" Style="{StaticResource PrimaryButton}"
                                MinWidth="124" Margin="0,0,8,0" Click="EventLogsRefresh_Click"/>
                        <Button x:Name="BtnEventLogsClear" Content="Очистить выбранные" Style="{StaticResource DangerButton}"
                                MinWidth="168" Click="EventLogsClear_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
